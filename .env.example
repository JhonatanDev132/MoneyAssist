# ---------------------------------------------------------------------------
# Variáveis de SERVIDOR. Nunca use o prefixo VITE_ aqui: o Vite publica toda
# variável VITE_* no JavaScript do navegador, e qualquer pessoa poderia copiá-la.
# ---------------------------------------------------------------------------

# Chave do Gemini (grátis): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Conta de serviço do Firebase (Console > Configurações do projeto > Contas de
# serviço > Gerar nova chave privada). Cole o JSON inteiro em UMA linha, ou o
# conteúdo dele em base64 (ex.: base64 -w0 chave.json).
FIREBASE_SERVICE_ACCOUNT=

# ---- Opcionais -------------------------------------------------------------
# URL do Realtime Database, se não for o padrão https://<projectId>-default-rtdb.firebaseio.com
# FIREBASE_DATABASE_URL=

# Modelos do Gemini em ordem de tentativa (ids separados por vírgula).
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.5-flash

# Análises de IA por usuário por dia (padrão 5).
# ANALISE_LIMITE_DIARIO=5
